{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/destination/:id", "destination": "/destinations/:id", "permanent": true },
    { "source": "/guide", "destination": "/guides", "permanent": true },
    { "source": "/guide/:id", "destination": "/guides/:id", "permanent": true },
    { "source": "/about", "destination": "/company/about", "permanent": true },
    { "source": "/contact", "destination": "/company/contact", "permanent": true },
    { "source": "/careers", "destination": "/company/careers", "permanent": true },
    { "source": "/partnerships", "destination": "/company/partnerships", "permanent": true },
    { "source": "/sponsors", "destination": "/company/sponsors", "permanent": true },
    { "source": "/stays", "destination": "/company/stays", "permanent": true },
    { "source": "/camping", "destination": "/company/camping", "permanent": true },
    { "source": "/privacy", "destination": "/legal/privacy", "permanent": true },
    { "source": "/terms", "destination": "/legal/terms", "permanent": true },
    { "source": "/cookies", "destination": "/legal/cookies", "permanent": true },
    { "source": "/cancellation", "destination": "/legal/cancellation", "permanent": true },
    { "source": "/disclaimer", "destination": "/legal/disclaimer", "permanent": true },
    { "source": "/accessibility", "destination": "/legal/accessibility", "permanent": true },
    { "source": "/grievance", "destination": "/legal/grievance", "permanent": true },
    { "source": "/copyright", "destination": "/legal/copyright", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/bookings",
      "destination": "/api/account?resource=bookings"
    },
    {
      "source": "/api/profile",
      "destination": "/api/account?resource=profile"
    },
    {
      "source": "/api/settings",
      "destination": "/api/account?resource=settings"
    },
    {
      "source": "/api/notifications",
      "destination": "/api/account?resource=notifications"
    },
    {
      "source": "/account/:path*",
      "destination": "/account/login/index.html"
    },
    {
      "source": "/journal/:path*",
      "destination": "/journal/index.html"
    }
  ]
}
