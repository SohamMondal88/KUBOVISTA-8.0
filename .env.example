# Public application URL
APP_URL=https://kubovista.com/

# Enable these only after Firebase Authentication, Firestore and authorized
# domains are configured and the Admin service-account key is installed.
FIREBASE_AUTH_ENABLED=false
FIREBASE_GOOGLE_ENABLED=false
FIREBASE_PUSH_ENABLED=false
# Generate with: openssl rand -base64 32. Keep the value in Vercel only.
PUSH_DISPATCH_SECRET=
FIREBASE_USE_ADC=false

# Legacy PostgreSQL features (journal moderation, companion matching and
# business enquiries) only. Authentication and the account dashboard use Firestore.
DATABASE_URL=

# Optional non-auth transactional email (Firebase sends auth emails).
RESEND_API_KEY=
AUTH_EMAIL_FROM=KuboVistas <contact@kubovista.com>

# Razorpay server credentials. Keep all values in Vercel only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_ADVANCE_PERCENT=20

# Comma-separated accounts allowed to create quotations.
ADMIN_EMAILS=

# Weather: commercial key required for business production usage.
OPEN_METEO_API_KEY=
# Non-commercial evaluation only; leave false in production.
WEATHER_DEMO=false

# Activate enquiries only after configuring and monitoring the team inbox.
ENQUIRIES_ENABLED=true
PUBLIC_CONTACT_EMAIL=contact@kubovista.com
PUBLIC_CONTACT_PHONE=+91-6297-179-823
PUBLIC_BUSINESS_ADDRESS=Kolkata, West Bengal, India

# Verified company social profiles; blank entries show Coming soon.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kubo_vista.official/
PUBLIC_YOUTUBE_URL=
PUBLIC_WHATSAPP_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_URL=

# Optional Kubo AI. Keep API keys server-side in Vercel only.
KUBO_AI_ENABLED=false
GEMINI_API_KEY=
OPENAI_MODEL=

# Firebase Admin credentials are server-only secrets. Set these in Vercel.
# Never paste a private key into this file or any committed file.
FIREBASE_PROJECT_ID=kubovistas-6666
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternatively use GOOGLE_APPLICATION_CREDENTIALS outside the repository.

# AdSense publisher and supplied display/AMP slot.
ADSENSE_PUBLISHER_ID=ca-pub-3851312120061760
ADSENSE_ENABLED=true
ADSENSE_SLOT_ID=8921763854
ADSENSE_CONSENT_READY=true
