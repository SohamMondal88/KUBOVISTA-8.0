# Public application URL
APP_URL=https://kubovista.com/

# Set true only after migration 007, user mapping and Firebase console setup.
FIREBASE_AUTH_ENABLED=true
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_PUSH_ENABLED=true
# Generate with openssl rand -base64 32; used only by a private retry scheduler.
PUSH_DISPATCH_SECRET="JD+MOBzkTTzb3F26ezIwfYfQ1SGuabYxqKRweBMpJdY="
FIREBASE_USE_ADC=true

# PostgreSQL / Neon pooled connection string
DATABASE_URL=https://kubovistas-6666-default-rtdb.firebaseio.com/

# Optional non-auth transactional email (Firebase sends auth emails)
RESEND_API_KEY=
AUTH_EMAIL_FROM=KuboVistas <contact@kubovista.com>


# Razorpay server credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_ADVANCE_PERCENT=20

# Comma-separated accounts allowed to create quotations
ADMIN_EMAILS=

# Weather: commercial key required for business production usage.
OPEN_METEO_API_KEY=
# Non-commercial evaluation only; leave false in production.
WEATHER_DEMO=true

# Activate enquiries only after configuring and monitoring the team inbox.
ENQUIRIES_ENABLED=true
PUBLIC_CONTACT_EMAIL="contact@kubovista.com"
PUBLIC_CONTACT_PHONE="+91-6297-179-823"
PUBLIC_BUSINESS_ADDRESS="Kolkata, West bengal, India"


# Verified company social profiles; blank entries show Coming soon.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kubo_vista.official/
PUBLIC_YOUTUBE_URL=
PUBLIC_WHATSAPP_URL=
PUBLIC_LINKEDIN_URL=
PUBLIC_TWITTER_URL=

# Optional Kubo AI. Keep the API key server-side; built-in guide needs no key.
KUBO_AI_ENABLED=true
GEMINI_API_KEY=
# Select a text model supporting Responses API and max_output_tokens.
OPENAI_MODEL=

# Optional Firebase Admin; SERVER ONLY. Never put these values in browser config.
FIREBASE_PROJECT_ID=kubovistas-6666
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@kubovistas-6666.iam.gserviceaccount.com
